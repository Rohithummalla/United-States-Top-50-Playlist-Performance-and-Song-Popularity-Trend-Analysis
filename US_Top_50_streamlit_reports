      "source": [
        "### Create your Streamlit dashboard ----------------\n",
        "\n",
        "\n",
        "%%writefile app.py\n",
        "import pandas as pd\n",
        "import streamlit as st\n",
        "import plotly.express as px\n",
        "\n",
        "st.set_page_config(\n",
        "    page_title=\"US Top 50 Music Analytics\",\n",
        "    page_icon=\"🎵\",\n",
        "    layout=\"wide\"\n",
        ")\n",
        "\n",
        "@st.cache_data\n",
        "def load_data():\n",
        "    data = pd.read_csv(\"/content/playlist_cleaned.csv\")\n",
        "\n",
        "    required = [\n",
        "        \"date\", \"position\", \"song\",\n",
        "        \"artist\", \"popularity\"\n",
        "    ]\n",
        "\n",
        "    missing = [c for c in required if c not in data.columns]\n",
        "    if missing:\n",
        "        raise ValueError(f\"Missing required columns: {missing}\")\n",
        "\n",
        "    data[\"date\"] = pd.to_datetime(\n",
        "        data[\"date\"], dayfirst=True, errors=\"coerce\"\n",
        "    )\n",
        "    data[\"position\"] = pd.to_numeric(\n",
        "        data[\"position\"], errors=\"coerce\"\n",
        "    )\n",
        "    data[\"popularity\"] = pd.to_numeric(\n",
        "        data[\"popularity\"], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    data = data.dropna(\n",
        "        subset=[\"date\", \"position\", \"song\", \"artist\", \"popularity\"]\n",
        "    ).copy()\n",
        "\n",
        "    data[\"duration_min\"] = (\n",
        "        pd.to_numeric(data[\"duration_ms\"], errors=\"coerce\") / 60000\n",
        "        if \"duration_ms\" in data.columns else float(\"nan\")\n",
        "    )\n",
        "\n",
        "    return data\n",
        "\n",
        "st.title(\"🎵 United States Top 50 Playlist Analytics\")\n",
        "st.write(\n",
        "    \"Explore song rankings, popularity, artist performance \"\n",
        "    \"and playlist trends over time.\"\n",
        ")\n",
        "\n",
        "try:\n",
        "    df = load_data()\n",
        "except Exception as e:\n",
        "    st.error(f\"Unable to load the dataset: {e}\")\n",
        "    st.stop()\n",
        "\n",
        "# Sidebar filters\n",
        "st.sidebar.header(\"Dashboard Filters\")\n",
        "\n",
        "start = df[\"date\"].min().date()\n",
        "end = df[\"date\"].max().date()\n",
        "\n",
        "date_range = st.sidebar.date_input(\n",
        "    \"Select date range\",\n",
        "    value=(start, end),\n",
        "    min_value=start,\n",
        "    max_value=end\n",
        ")\n",
        "\n",
        "if isinstance(date_range, (tuple, list)) and len(date_range) == 2:\n",
        "    start_date, end_date = date_range\n",
        "    df = df[df[\"date\"].dt.date.between(start_date, end_date)]\n",
        "\n",
        "artists = sorted(df[\"artist\"].dropna().astype(str).unique())\n",
        "selected_artists = st.sidebar.multiselect(\"Select artists\", artists)\n",
        "\n",
        "if selected_artists:\n",
        "    df = df[df[\"artist\"].isin(selected_artists)]\n",
        "\n",
        "songs = sorted(df[\"song\"].dropna().astype(str).unique())\n",
        "selected_songs = st.sidebar.multiselect(\"Select songs\", songs)\n",
        "\n",
        "if selected_songs:\n",
        "    df = df[df[\"song\"].isin(selected_songs)]\n",
        "\n",
        "rank_range = st.sidebar.slider(\n",
        "    \"Playlist rank range\",\n",
        "    min_value=1,\n",
        "    max_value=50,\n",
        "    value=(1, 50)\n",
        ")\n",
        "\n",
        "df = df[df[\"position\"].between(*rank_range)]\n",
        "\n",
        "if \"album_type\" in df.columns:\n",
        "    album_types = sorted(df[\"album_type\"].dropna().astype(str).unique())\n",
        "    selected_types = st.sidebar.multiselect(\n",
        "        \"Album type\", album_types, default=album_types\n",
        "    )\n",
        "    df = df[df[\"album_type\"].astype(str).isin(selected_types)]\n",
        "\n",
        "if df.empty:\n",
        "    st.warning(\"No data matches your selected filters. Change the filters.\")\n",
        "    st.stop()\n",
        "\n",
        "# KPI cards\n",
        "song_days = df.groupby([\"song\", \"artist\"])[\"date\"].nunique()\n",
        "c1, c2, c3, c4 = st.columns(4)\n",
        "\n",
        "c1.metric(\"Unique songs\", df[\"song\"].nunique())\n",
        "c2.metric(\"Artists\", df[\"artist\"].nunique())\n",
        "c3.metric(\"Average popularity\", f\"{df['popularity'].mean():.2f}\")\n",
        "c4.metric(\"Average rank\", f\"{df['position'].mean():.2f}\")\n",
        "\n",
        "st.caption(\n",
        "    f\"Records: {len(df):,} | \"\n",
        "    f\"Period: {df['date'].min().date()} to {df['date'].max().date()}\"\n",
        ")\n",
        "\n",
        "st.divider()\n",
        "\n",
        "# Popularity trend\n",
        "st.subheader(\"1. Popularity Trend Over Time\")\n",
        "\n",
        "daily = df.groupby(\"date\", as_index=False).agg(\n",
        "    average_popularity=(\"popularity\", \"mean\")\n",
        ")\n",
        "\n",
        "fig = px.line(\n",
        "    daily, x=\"date\", y=\"average_popularity\",\n",
        "    title=\"Average popularity by snapshot date\"\n",
        ")\n",
        "st.plotly_chart(fig, use_container_width=True)\n",
        "\n",
        "# Ranking trends\n",
        "st.subheader(\"2. Song Ranking Trends\")\n",
        "\n",
        "if not selected_songs:\n",
        "    default_songs = (\n",
        "        df.groupby([\"song\", \"artist\"])[\"date\"]\n",
        "          .nunique()\n",
        "          .sort_values(ascending=False)\n",
        "          .head(5)\n",
        "          .reset_index()[[\"song\", \"artist\"]]\n",
        "    )\n",
        "    trend = df.merge(default_songs, on=[\"song\", \"artist\"])\n",
        "else:\n",
        "    trend = df[df[\"song\"].isin(selected_songs)]\n",
        "\n",
        "fig = px.line(\n",
        "    trend.sort_values(\"date\"),\n",
        "    x=\"date\", y=\"position\",\n",
        "    color=\"song\", hover_data=[\"artist\"],\n",
        "    title=\"Song rank over time\"\n",
        ")\n",
        "fig.update_yaxes(autorange=\"reversed\", dtick=5)\n",
        "st.plotly_chart(fig, use_container_width=True)\n",
        "\n",
        "# Artist leaderboard\n",
        "st.subheader(\"3. Artist Performance Leaderboard\")\n",
        "\n",
        "artist_stats = df.groupby(\"artist\", as_index=False).agg(\n",
        "    unique_songs=(\"song\", \"nunique\"),\n",
        "    active_dates=(\"date\", \"nunique\"),\n",
        "    average_rank=(\"position\", \"mean\"),\n",
        "    average_popularity=(\"popularity\", \"mean\")\n",
        ")\n",
        "\n",
        "artist_stats = artist_stats.sort_values(\n",
        "    [\"active_dates\", \"unique_songs\"],\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "st.dataframe(\n",
        "    artist_stats.head(20).round(2),\n",
        "    use_container_width=True,\n",
        "    hide_index=True\n",
        ")\n",
        "\n",
        "# Popularity versus rank\n",
        "st.subheader(\"4. Popularity vs Rank\")\n",
        "\n",
        "fig = px.scatter(\n",
        "    df, x=\"popularity\", y=\"position\",\n",
        "    color=\"album_type\" if \"album_type\" in df.columns else None,\n",
        "    hover_data=[\"song\", \"artist\"],\n",
        "    title=\"Popularity score versus playlist position\"\n",
        ")\n",
        "fig.update_yaxes(autorange=\"reversed\")\n",
        "st.plotly_chart(fig, use_container_width=True)\n",
        "\n",
        "# Explicit content comparison\n",
        "if \"is_explicit\" in df.columns:\n",
        "    st.subheader(\"5. Explicit vs Non-explicit Performance\")\n",
        "\n",
        "    explicit_stats = df.groupby(\"is_explicit\", as_index=False).agg(\n",
        "        records=(\"song\", \"size\"),\n",
        "        average_popularity=(\"popularity\", \"mean\"),\n",
        "        average_rank=(\"position\", \"mean\")\n",
        "    )\n",
        "\n",
        "    st.dataframe(\n",
        "        explicit_stats.round(2),\n",
        "        use_container_width=True,\n",
        "        hide_index=True\n",
        "    )\n",
        "\n",
        "# Duration comparison\n",
        "if \"duration_min\" in df.columns:\n",
        "    duration_df = df.dropna(subset=[\"duration_min\"])\n",
        "\n",
        "    if not duration_df.empty:\n",
        "        st.subheader(\"6. Song Duration vs Popularity\")\n",
        "\n",
        "        fig = px.scatter(\n",
        "            duration_df,\n",
        "            x=\"duration_min\",\n",
        "            y=\"popularity\",\n",
        "            hover_data=[\"song\", \"artist\"],\n",
        "            title=\"Song length and popularity\"\n",
        "        )\n",
        "        st.plotly_chart(fig, use_container_width=True)\n",
        "\n",
        "# Download filtered data\n",
        "st.subheader(\"Download Results\")\n",
        "\n",
        "st.download_button(\n",
        "    \"Download filtered CSV\",\n",
        "    data=df.to_csv(index=False).encode(\"utf-8\"),\n",
        "    file_name=\"filtered_playlist_data.csv\",\n",
        "    mime=\"text/csv\"\n",
        ")\n",
        "\n",
        "st.success(\"Dashboard loaded successfully.\")\n"
      ]
